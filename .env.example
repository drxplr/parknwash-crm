# Public frontend configuration. Never put service-role or secret keys here.
VITE_CRM_MODE=cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Enable only after configuring and verifying custom SMTP in Supabase.
VITE_EMAIL_AUTH_ENABLED=false
